{
  "name": "eduvi-lms-backend",
  "version": "1.0.0",
  "description": "Backend API for Eduvi LMS",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon --exec ts-node src/app.ts",
    "seed": "ts-node src/seeders/demo-seeder.ts",
    "seed:courses": "ts-node src/seeders/course-seeder.ts",
